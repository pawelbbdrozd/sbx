{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg":          "#212733",
    "bg_panel":    "#1e232e",
    "bg_elem":     "#212733",
    "fg":          "#D9D7CE",
    "fg_muted":    "#8A7E72",
    "accent":      "#E6B34A",
    "primary":     "#E6B34A",
    "keyword":     "#D4813E",
    "func":        "#E6B34A",
    "string":      "#B5C96A",
    "entity":      "#7AAFC4",
    "constant":    "#C4889E",
    "regexp":      "#6E8F56",
    "operator":    "#C4A87A",
    "markup":      "#C05A3A",
    "comment":     "#757b8a",
    "error":       "#C05A3A",
    "warning":     "#D4813E",
    "success":     "#8AAF6E",
    "success_bg":  "#1c2316",
    "border":      "#1A1210",
    "border_act":  "#3D3430"
  },
  "theme": {
    "primary":            { "dark": "primary",         "light": "primary"         },
    "secondary":          { "dark": "entity",           "light": "entity"           },
    "accent":             { "dark": "func",             "light": "func"             },
    "error":              { "dark": "error",            "light": "error"            },
    "warning":            { "dark": "warning",          "light": "warning"          },
    "success":            { "dark": "success",          "light": "success"          },
    "info":               { "dark": "entity",           "light": "entity"           },

    "text":               { "dark": "fg",               "light": "fg"               },
    "textMuted":          { "dark": "fg_muted",         "light": "fg_muted"         },

    "background":         { "dark": "bg",               "light": "bg"               },
    "backgroundPanel":    { "dark": "bg_panel",         "light": "bg_panel"         },
    "backgroundElement":  { "dark": "bg_panel",         "light": "bg_panel"               },

    "border":             { "dark": "border",           "light": "border"           },
    "borderActive":       { "dark": "border_act",       "light": "border_act"       },
    "borderSubtle":       { "dark": "border",           "light": "border"           },

    "diffAdded":              { "dark": "success",      "light": "success"      },
    "diffRemoved":            { "dark": "error",        "light": "error"        },
    "diffContext":            { "dark": "fg_muted",     "light": "fg_muted"     },
    "diffHunkHeader":         { "dark": "fg_muted",     "light": "fg_muted"     },
    "diffHighlightAdded":     { "dark": "success",      "light": "success"      },
    "diffHighlightRemoved":   { "dark": "error",        "light": "error"        },
    "diffAddedBg":            { "dark": "success_bg",      "light": "bg_elem"      },
    "diffRemovedBg":          { "dark": "bg_elem",      "light": "bg_elem"      },
    "diffContextBg":          { "dark": "bg_panel",     "light": "bg_panel"     },
    "diffLineNumber":         { "dark": "fg_muted",     "light": "fg_muted"     },
    "diffAddedLineNumberBg":  { "dark": "bg_elem",      "light": "bg_elem"      },
    "diffRemovedLineNumberBg":{ "dark": "bg_elem",      "light": "bg_elem"      },

    "markdownText":           { "dark": "fg",           "light": "fg"           },
    "markdownHeading":        { "dark": "accent",       "light": "accent"       },
    "markdownLink":           { "dark": "entity",       "light": "entity"       },
    "markdownLinkText":       { "dark": "regexp",       "light": "regexp"       },
    "markdownCode":           { "dark": "string",       "light": "string"       },
    "markdownBlockQuote":     { "dark": "fg_muted",     "light": "fg_muted"     },
    "markdownEmph":           { "dark": "keyword",      "light": "keyword"      },
    "markdownStrong":         { "dark": "accent",       "light": "accent"       },
    "markdownHorizontalRule": { "dark": "border",       "light": "border"       },
    "markdownListItem":       { "dark": "fg",           "light": "fg"           },
    "markdownListEnumeration":{ "dark": "accent",       "light": "accent"       },
    "markdownImage":          { "dark": "entity",       "light": "entity"       },
    "markdownImageText":      { "dark": "regexp",       "light": "regexp"       },
    "markdownCodeBlock":      { "dark": "fg",           "light": "fg"           },

    "syntaxComment":          { "dark": "comment",      "light": "comment"      },
    "syntaxKeyword":          { "dark": "keyword",      "light": "keyword"      },
    "syntaxFunction":         { "dark": "func",         "light": "func"         },
    "syntaxVariable":         { "dark": "fg",           "light": "fg"           },
    "syntaxString":           { "dark": "string",       "light": "string"       },
    "syntaxNumber":           { "dark": "constant",     "light": "constant"     },
    "syntaxType":             { "dark": "entity",       "light": "entity"       },
    "syntaxOperator":         { "dark": "operator",     "light": "operator"     },
    "syntaxPunctuation":      { "dark": "fg_muted",     "light": "fg_muted"     }
  }
}
